server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Static assets with hash in filename
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API endpoints to vozonda-api (every path the UI, podcast apps and share links use; per-show
    # feeds are /{creator}/{show}/feed.xml)
    location ~ ^/((auth|providers|jobs|audio|settings|meta|watchlist|doctor|health|e|source|sources|tts|shows|styles|plugins|music|storage|clips|vtt|srt|img|share|llm|distribution|billing)(/|$)|feed\.xml$|og-default\.png$|llms\.txt$|[^/]+/[^/]+/feed\.xml$) {
        proxy_pass ${VOZONDA_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        # Pass on only what an outer reverse proxy sent: the API reads a non-empty X-Forwarded-For as
        # "this request came from outside" and then asks for the token (GHSA-crq5-73gf-fv2h). A local
        # browser sends none, so local use stays open.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for Server-Sent Events (SSE /jobs/{id}/events)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
