# ==============================================================================
# Vozonda - Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ports & Storage
# ------------------------------------------------------------------------------
# Host port mapping for the backend API service (default: 8787).
# If port 8787 is already in use, change this to an unused port (e.g. 9787).
VOZONDA_PORT=8787

# Host port mapping for the web frontend UI (default: 4173).
# If port 4173 is already in use, change this to an unused port (e.g. 5173).
VOZONDA_WEB_PORT=4173

# Root directory for Vozonda data (secrets, models, media).
# Defaults to ~/vozonda. Production sets VOZONDA_ROOT=/data explicitly.
# (native install only; Docker mounts /app/data and /app/media directly)
# VOZONDA_ROOT=/data

# Public address of this install, used in share pages, OG tags, clip links and
# webhook payloads. Leave empty to use the address each request comes in on;
# set it when a reverse proxy rewrites the host (e.g. https://pods.example.org)
# (native install only, or pass via docker-compose.override.yml)
VOZONDA_PUBLIC_URL=

# ------------------------------------------------------------------------------
# LLM (Script Generation)
# ------------------------------------------------------------------------------
# OpenAI-compatible API base URL (defaults to host Ollama instance).
# The container reaches your host LLM via host.docker.internal (Docker's hostname
# for the host machine). If you get "LLM unreachable", make sure Ollama binds
# to 0.0.0.0 (not just 127.0.0.1) on Linux:
#   OLLAMA_HOST=0.0.0.0:11434 ollama serve
VOZONDA_LLM_BASE=http://host.docker.internal:11434/v1

# Model identifier for script generation (e.g. qwen2.5:latest, llama3.2)
VOZONDA_LLM_MODEL=qwen2.5:latest

# Human-readable label for the configured LLM backend
VOZONDA_LLM_LABEL=local-llm

# Optional JSON fallback chain for LLM endpoints if primary is unavailable
VOZONDA_LLM_FALLBACKS=

# Optional OpenAI API key (leave empty when using local Ollama or vLLM)
OPENAI_API_KEY=

# Optional Anthropic API key for Claude script generation fallback
ANTHROPIC_API_KEY=
# Optional cloud script writer via NVIDIA NIM (llm.engine = kimi_nim in settings).
# The model is a setting (llm.nim_model; the settings page lists what NIM offers),
# or VOZONDA_NIM_MODEL below. Kimi K3 (moonshotai/kimi-k3) did well in our bench.
# Key from build.nvidia.com; alternatively put it in secrets/nvidia_nim_api.key.
# The free developer key is for testing and prototyping only (NVIDIA API Trial Terms);
# production use needs an NVIDIA AI Enterprise licence.
# The source text of every episode is sent to NVIDIA when this engine is selected.
# (native install only, or pass via docker-compose.override.yml)
VOZONDA_NIM_API_KEY=
VOZONDA_NIM_MODEL=
# Optional cloud script writer via the OpenCode CLI (llm.engine = opencode).
# Models, tried in order, are the setting llm.opencode_models (the settings
# page lists what opencode offers) or this comma list. Free models may use the
# text for training and come and go; the CLI is found on PATH or in nvm.
# (native install only, or pass via docker-compose.override.yml)
VOZONDA_OPENCODE_MODELS=
VOZONDA_OPENCODE_BIN=
# Any writer can back up another: set llm.backup_engine in the settings page.

# ------------------------------------------------------------------------------
# TTS (Text-to-Speech Engine)
# ------------------------------------------------------------------------------
# Default voice engine: kokoro (CPU default, English and 7 more languages),
# piper (CPU fallback for German and other languages kokoro lacks),
# qwen_tts (GPU opt-in), or voxtral
VOZONDA_TTS_ENGINE=kokoro

# Path to the TTS renderer script inside the container
VOZONDA_TTS_SCRIPT=/app/apps/api/src/vozonda_api/render_kokoro.py

# Python interpreter path for running TTS rendering
VOZONDA_TTS_PY=/usr/local/bin/python

# Optional JSON fallback chain for cloud TTS providers
VOZONDA_TTS_FALLBACKS=

# Optional ElevenLabs API key for cloud TTS fallback
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Optional Bearer token for write endpoints (required when exposed beyond localhost)
VOZONDA_TOKEN=

# ------------------------------------------------------------------------------
# Watchlist (RSS / Nostr Background Poller)
# ------------------------------------------------------------------------------
# Interval in seconds between automated feed checks (default: 600s / 10m)
VOZONDA_WATCHLIST_INTERVAL=600

# Maximum number of new episodes to render per watchlist check cycle
VOZONDA_WATCHLIST_MAX_NEW=3

# ------------------------------------------------------------------------------
# More settings (native install only, or pass via docker-compose.override.yml)
# ------------------------------------------------------------------------------

# API Key for Mistral AI Audio TTS endpoint (https://api.mistral.ai/v1/audio/tts).
# Used by the "voxtral" engine for high-speed French/European voices with emotion tags.
# Note: Vozonda also automatically checks `~/secrets/mistral_api.key` on Sparki.
# (native install only, or pass via docker-compose.override.yml)
# MISTRAL_API_KEY=your_mistral_api_key_here

# VOXTRAL_API_KEY=your_voxtral_api_key_here

# Hugging Face model cache directory (absolute container path for Docker;
# for native install without Docker: ~/.cache/vozonda/hf):
VOZONDA_HF_HOME=/root/.cache/vozonda/hf

# SQLite database path for jobs, watchlists, and settings
# (native install only; Docker uses /app/data/jobs.db):
VOZONDA_DB=./data/jobs.db

# Directory for storing rendered episode audio files
# (native install only; Docker uses /app/media):
# VOZONDA_MEDIA=./media

# API bind address (native install only; Docker binds 0.0.0.0 inside container):
VOZONDA_HOST=127.0.0.1

# Allowed CORS origins (comma-separated; native install only):
# VOZONDA_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Node/app Lightning address for Podcasting 2.0 value splits.
# The app share of value-for-value payments supports Vozonda development; replace or leave empty to disable. Only active once a creator address is set.
# (native install only, or pass via docker-compose.override.yml)
VOZONDA_NODE_V4V_ADDRESS=vozonda@rizful.com
